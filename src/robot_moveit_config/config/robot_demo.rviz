# RViz layout for the Gazebo demo (gazebo.launch.py world:=workspace perception:=true
# perception_scene:=true use_rviz:=true rviz_config:=robot_demo.rviz).
# Everything here is published by the demo itself; a unit test (test_rviz_config.py) checks that
# every topic and frame named below really exists in the code.
# No `QMainWindow State` on purpose: RViz lays the panels out itself (the camera images show up
# as two small panels above MotionPlanning; drag their borders to enlarge them, then File > Save
# Config if you want to keep your own arrangement).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Algılanan nesneler1
        - /MotionPlanning1
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Reference Frame: world
      Plane Cell Count: 10
      Cell Size: 0.2
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        world:
          Value: true
        base_link:
          Value: true
        link_6:
          Value: true
        camera_link:
          Value: true
        camera_optical_frame:
          Value: true
      Marker Scale: 0.15
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Kamera (RGB)
      Enabled: true
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/image
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Kamera (derinlik)
      Enabled: true
      Max Value: 2
      Min Value: 0.5
      Median window: 5
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth_image
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Algılanan nesneler
      Enabled: true
      Namespaces:
        blue: true
        green: true
        red: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/objects
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Planned Path:
        Loop Animation: true
        State Display Time: 0.05 s
        Trajectory Topic: display_planned_path
      Planning Scene Topic: monitored_planning_scene
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 0.35
        Show Scene Geometry: true
      Scene Robot:
        Robot Alpha: 0.7
        Show Scene Robot: true
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.2
      Focal Point:
        X: 0.3
        Y: 0.0
        Z: 0.45
      Name: Current View
      Pitch: 0.5
      Target Frame: world
      Yaw: -2.2
Window Geometry:
  Height: 975
  Width: 1500
  Kamera (RGB):
    collapsed: false
  Kamera (derinlik):
    collapsed: false
