<?xml version="1.0" encoding="UTF-8"?>
<!-- ÜRETİLDİ: src/robot_description/profile/six_axis_robot.yaml dosyasından `python3 -m robot_core.profile_gen` ile üretildi. ELLE DÜZENLEME: profili düzenle, yeniden üret (pytest güncel mi diye denetler). -->
<robot name="six_axis_robot">
    <group name="robot_arm">
        <joint name="joint_1"/>
        <joint name="joint_2"/>
        <joint name="joint_3"/>
        <joint name="joint_4"/>
        <joint name="joint_5"/>
        <joint name="joint_6"/>
    </group>
    <!--GROUP STATES: named joint poses (profile: moveit.named_poses)-->
    <group_state name="home" group="robot_arm">
        <joint name="joint_1" value="0.0"/>
        <joint name="joint_2" value="0.0"/>
        <joint name="joint_3" value="0.0"/>
        <joint name="joint_4" value="0.0"/>
        <joint name="joint_5" value="0.0"/>
        <joint name="joint_6" value="0.0"/>
    </group_state>
    <group_state name="cnc" group="robot_arm">
        <joint name="joint_1" value="0.5"/>
        <joint name="joint_2" value="-0.4"/>
        <joint name="joint_3" value="0.4"/>
        <joint name="joint_4" value="0.0"/>
        <joint name="joint_5" value="0.5"/>
        <joint name="joint_6" value="0.0"/>
    </group_state>
    <group_state name="pc" group="robot_arm">
        <joint name="joint_1" value="-0.5"/>
        <joint name="joint_2" value="-0.3"/>
        <joint name="joint_3" value="0.3"/>
        <joint name="joint_4" value="-0.2"/>
        <joint name="joint_5" value="0.5"/>
        <joint name="joint_6" value="0.0"/>
    </group_state>
    <group_state name="dik" group="robot_arm">
        <joint name="joint_1" value="0.0"/>
        <joint name="joint_2" value="-1.57"/>
        <joint name="joint_3" value="1.57"/>
        <joint name="joint_4" value="0.0"/>
        <joint name="joint_5" value="0.0"/>
        <joint name="joint_6" value="0.0"/>
    </group_state>
    <group_state name="ready" group="robot_arm">
        <joint name="joint_1" value="0.0"/>
        <joint name="joint_2" value="-0.1"/>
        <joint name="joint_3" value="1.65"/>
        <joint name="joint_4" value="0.0"/>
        <joint name="joint_5" value="1.2"/>
        <joint name="joint_6" value="0.0"/>
    </group_state>
    <!--VIRTUAL JOINT: fixes the robot base to the world frame-->
    <virtual_joint name="masa" type="fixed" parent_frame="world" child_link="base_link"/>
    <!--DISABLE COLLISIONS: parent-child links overlap at their joint and are always disabled;
         anything else is checked unless the profile lists it under moveit.collision.allow_extra
         (with a reason). Without the adjacent entries every state is reported as self-collision.-->
    <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
    <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
    <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
    <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
    <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
    <disable_collisions link1="link_5" link2="link_6" reason="Adjacent"/>
</robot>
