<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_viz</name>
  <version>0.1.0</version>
  <description>Read-only browser view of the robot: camera, detections, joints (logic lives in robot_core.viz / robot_core.webview)</description>
  <maintainer email="facar7711@gmail.com">facar771</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>robot_core</depend>
  <depend>robot_controller</depend>
  <depend>robot_perception</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>robot_sim</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
