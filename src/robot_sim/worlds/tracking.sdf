<?xml version="1.0"?>
<!-- Tracking world: a 3-DoF camera platform and a scripted red target.
     Platform chain (matches robot_vision.platform): world -> yaw (about z at the pivot) ->
     slide (along the yawed x axis) -> pitch (about y, positive = camera looks DOWN) -> camera.
     Joints are driven by rate commands (JointController, velocity mode):
         /platform/<yaw|slide|pitch>_joint/cmd_vel   (gz.msgs.Double, rad/s or m/s)
     Joint states: /platform/joint_states (gz.msgs.Model). The target is moved ONLY by
     /world/tracking/set_pose (deterministic scripts in robot_vision_ros), it has no collision and no
     gravity. Limits / pivot height must match robot_vision.platform and robot_vision.trajectories. -->
<sdf version="1.9">
  <world name="tracking">
    <!-- 10 ms steps and a real-time factor of 0.4: only kinematic joints move here, and a faster
         /clock + joint-state stream or a sim that outruns the (software-rendered, 2-CPU) pipeline
         starves the ROS bridge, so commands reach the joints seconds late in sim time. Slower sim
         time = the loop sees the same latency in far fewer simulated seconds. -->
    <physics name="10ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>0.4</real_time_factor>
    </physics>
    <!-- bullet-featherstone, not the default DART: with three velocity-driven joints in one chain DART
         kept the first (saturated) velocity for seconds and ignored later commands (reproduced with a
         plain command replay, no tracking code involved); bullet-featherstone follows them. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- no gravity: the target is a free body moved by set_pose and the platform joints are
         kinematic; per-link <gravity>false</gravity> is ignored by bullet-featherstone (the target
         fell through the floor). -->
    <gravity>0 0 0</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The target: a red sphere, r = 0.10 m. Moved by set_pose only. -->
    <model name="target">
      <pose>3.5 -0.8 1.0 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.10</radius></sphere></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Camera platform; the model origin is the pivot (height 1.0 m, see PIVOT_HEIGHT). -->
    <model name="cam_platform">
      <pose>0 0 1.0 0 0 0</pose>
      <link name="base">
        <gravity>false</gravity>
        <inertial>
          <mass>5</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 -0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
      <joint name="anchor" type="fixed"><parent>world</parent><child>base</child></joint>

      <link name="yaw_link">
        <gravity>false</gravity>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <joint name="yaw_joint" type="revolute">
        <parent>base</parent><child>yaw_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1.2</lower><upper>1.2</upper><effort>1000</effort><velocity>1.5</velocity></limit>
          <dynamics><damping>0.0</damping><friction>0.0</friction></dynamics>
        </axis>
      </joint>

      <link name="slide_link">
        <gravity>false</gravity>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <joint name="slide_joint" type="prismatic">
        <parent>yaw_link</parent><child>slide_link</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>0.0</lower><upper>2.5</upper><effort>1000</effort><velocity>0.8</velocity></limit>
          <dynamics><damping>0.0</damping><friction>0.0</friction></dynamics>
        </axis>
      </joint>

      <link name="pitch_link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.005</ixx><iyy>0.005</iyy><izz>0.005</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="body">
          <geometry><box><size>0.08 0.06 0.05</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="rgbd_camera" type="rgbd_camera">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>320</width><height>240</height></image>
            <clip><near>0.1</near><far>8.0</far></clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <topic>camera</topic>
          <gz_frame_id>camera_link</gz_frame_id>
        </sensor>
      </link>
      <joint name="pitch_joint" type="revolute">
        <parent>slide_link</parent><child>pitch_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-0.6</lower><upper>1.2</upper><effort>1000</effort><velocity>1.0</velocity></limit>
          <dynamics><damping>0.0</damping><friction>0.0</friction></dynamics>
        </axis>
      </joint>

      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>yaw_joint</joint_name>
        <use_velocity_commands>true</use_velocity_commands>
        <topic>/platform/yaw_joint/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>slide_joint</joint_name>
        <use_velocity_commands>true</use_velocity_commands>
        <topic>/platform/slide_joint/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>pitch_joint</joint_name>
        <use_velocity_commands>true</use_velocity_commands>
        <topic>/platform/pitch_joint/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/platform/joint_states</topic>
        <joint_name>yaw_joint</joint_name>
        <joint_name>slide_joint</joint_name>
        <joint_name>pitch_joint</joint_name>
      </plugin>
    </model>
  </world>
</sdf>
