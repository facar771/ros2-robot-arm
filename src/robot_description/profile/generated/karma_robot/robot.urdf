<?xml version="1.0"?>
<!-- ÜRETİLDİ: src/robot_description/profile/karma_robot/karma_robot.yaml dosyasından `python3 -m robot_core.profile_gen` (profile seçeneği: src/robot_description/profile/karma_robot/karma_robot.yaml) ile üretildi. ELLE DÜZENLEME: profili düzenle, yeniden üret (pytest güncel mi diye denetler). -->
<robot name="karma_robot">
  <material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.5 1.0 1.0"/></material>

  <!-- base_link needs an <inertial>: without it Gazebo (sdformat) lumps the link into the world and the first joint loses its parent. The xacro wrapper (robot_moveit_config) puts a massless `world` link above it, so KDL never sees an inertia on the root link. -->

  <link name="base_link">
    <!-- visual: CAD mesh (a picture, not a measurement); collision: one box per CAD part (robot_core.mesh_import) -->
    <visual><origin xyz="0.0 0.0 0.0"/><geometry><mesh filename="package://robot_description/meshes/karma_robot/link/base_link.stl"/></geometry><material name="gray"/></visual>
    <collision name="j1_taban_28byj48"><origin xyz="0.0055 0.0 0.03545"/><geometry><box size="0.115 0.1204 0.0711"/></geometry></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.0055 0.0 0.0355"/><mass value="0.15"/><inertia ixx="0.000244" ixy="0" ixz="0" iyy="0.000228" iyz="0" izz="0.000346"/></inertial>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/><origin xyz="0.0 0.0 0.061"/><axis xyz="0.0 0.0 1.0"/>
    <limit lower="-2.967" upper="2.967" effort="0.13" velocity="0.3"/>
  </joint>

  <link name="link_1">
    <!-- visual: CAD mesh (a picture, not a measurement); collision: one box per CAD part (robot_core.mesh_import) -->
    <visual><origin xyz="0.0 0.0 0.0"/><geometry><mesh filename="package://robot_description/meshes/karma_robot/link/link_1.stl"/></geometry><material name="orange"/></visual>
    <collision name="j2_taban_ustu_28byj48"><origin xyz="-0.01305 0.0 0.04495"/><geometry><box size="0.1221 0.096 0.0901"/></geometry></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="-0.013 0.0 0.045"/><mass value="0.22"/><inertia ixx="0.000317" ixy="0" ixz="0" iyy="0.000421" iyz="0" izz="0.000441"/></inertial>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/><origin xyz="0.0 0.0 0.06"/><axis xyz="0.0 1.0 0.0"/>
    <limit lower="0.05" upper="3.09" effort="0.5" velocity="0.08"/>
  </joint>

  <link name="link_2">
    <!-- visual: CAD mesh (a picture, not a measurement); collision: one box per CAD part (robot_core.mesh_import) -->
    <visual><origin xyz="0.0 0.0 0.0"/><geometry><mesh filename="package://robot_description/meshes/karma_robot/link/link_2.stl"/></geometry><material name="gray"/></visual>
    <collision name="j2-j3_kol"><origin xyz="-0.05875 5e-05 -0.0036"/><geometry><box size="0.1675 0.0261 0.0572"/></geometry></collision>
    <collision name="j3_dirsek_plakasi_1"><origin xyz="-0.12005 -0.01895 0.025"/><geometry><box size="0.0401 0.0101 0.09"/></geometry></collision>
    <collision name="j3_dirsek_plakasi_2"><origin xyz="-0.12005 0.01905 0.025"/><geometry><box size="0.0401 0.0101 0.09"/></geometry></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="-0.0588 0.0 0.0189"/><mass value="0.26"/><inertia ixx="0.000276" ixy="0" ixz="0" iyy="0.000833" iyz="0" izz="0.000657"/></inertial>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/><origin xyz="-0.12 0.0 0.05"/><axis xyz="0.0 -1.0 0.0"/>
    <limit lower="0.05" upper="3.09" effort="0.35" velocity="0.8"/>
  </joint>

  <link name="link_3">
    <!-- visual: CAD mesh (a picture, not a measurement); collision: one box per CAD part (robot_core.mesh_import) -->
    <visual><origin xyz="0.0 0.0 0.0"/><geometry><mesh filename="package://robot_description/meshes/karma_robot/link/link_3.stl"/></geometry><material name="orange"/></visual>
    <collision name="j3-j4_kol_2xsg90"><origin xyz="0.02995 5e-05 0.0"/><geometry><box size="0.1001 0.0261 0.0398"/></geometry></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
