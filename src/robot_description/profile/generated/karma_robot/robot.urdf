<?xml version="1.0"?>
<!-- ÜRETİLDİ: src/robot_description/profile/karma_robot/karma_robot.yaml dosyasından `python3 -m robot_core.profile_gen --profile src/robot_description/profile/karma_robot/karma_robot.yaml` ile üretildi. ELLE DÜZENLEME: profili düzenle, yeniden üret (pytest güncel mi diye denetler). -->
<robot name="karma_robot">
  <material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.5 1.0 1.0"/></material>

  <!-- base_link needs an <inertial>: without it Gazebo (sdformat) lumps the link into the world and the first joint loses its parent. The xacro wrapper (robot_moveit_config) puts a massless `world` link above it, so KDL never sees an inertia on the root link. -->

  <link name="base_link">
    <visual><geometry><cylinder radius="0.05" length="0.06"/></geometry><material name="gray"/><origin xyz="0.0 0.0 0.0"/></visual>
    <collision><geometry><cylinder radius="0.05" length="0.06"/></geometry><origin xyz="0.0 0.0 0.0"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.0 0.0 0.0"/><mass value="0.3"/><inertia ixx="0.000278" ixy="0" ixz="0" iyy="0.000278" iyz="0" izz="0.000375"/></inertial>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/><origin xyz="0.0 0.0 0.03"/><axis xyz="0.0 0.0 1.0"/>
    <limit lower="-3.0" upper="3.0" effort="1.0" velocity="0.5"/>
  </joint>

  <link name="link_1">
    <visual><geometry><cylinder radius="0.025" length="0.07"/></geometry><material name="orange"/><origin xyz="0.0 0.0 0.035"/></visual>
    <collision><geometry><cylinder radius="0.025" length="0.07"/></geometry><origin xyz="0.0 0.0 0.035"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.0 0.0 0.035"/><mass value="0.15"/><inertia ixx="8.5e-05" ixy="0" ixz="0" iyy="8.5e-05" iyz="0" izz="4.7e-05"/></inertial>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/><origin xyz="0.0 0.0 0.07"/><axis xyz="0.0 1.0 0.0"/>
    <limit lower="-1.4" upper="1.4" effort="1.0" velocity="0.5"/>
  </joint>

  <link name="link_2">
    <visual><geometry><box size="0.03 0.03 0.1"/></geometry><material name="gray"/><origin xyz="0.0 0.0 0.05"/></visual>
    <collision><geometry><box size="0.03 0.03 0.1"/></geometry><origin xyz="0.0 0.0 0.05"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.0 0.0 0.05"/><mass value="0.1"/><inertia ixx="9.1e-05" ixy="0" ixz="0" iyy="9.1e-05" iyz="0" izz="1.5e-05"/></inertial>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/><origin xyz="0.0 0.0 0.1"/><axis xyz="0.0 1.0 0.0"/>
    <limit lower="-1.5" upper="1.5" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="link_3">
    <visual><geometry><box size="0.025 0.025 0.09"/></geometry><material name="orange"/><origin xyz="0.0 0.0 0.045"/></visual>
    <collision><geometry><box size="0.025 0.025 0.09"/></geometry><origin xyz="0.0 0.0 0.045"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.0 0.0 0.045"/><mass value="0.08"/><inertia ixx="5.8e-05" ixy="0" ixz="0" iyy="5.8e-05" iyz="0" izz="8e-06"/></inertial>
  </link>
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/><child link="link_4"/><origin xyz="0.0 0.0 0.09"/><axis xyz="0.0 1.0 0.0"/>
    <limit lower="-1.5" upper="1.5" effort="1.0" velocity="1.0"/>
  </joint>

  <link name="link_4">
    <visual><geometry><cylinder radius="0.015" length="0.03"/></geometry><material name="blue"/><origin xyz="0.0 0.0 0.015"/></visual>
    <collision><geometry><cylinder radius="0.015" length="0.03"/></geometry><origin xyz="0.0 0.0 0.015"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.0 0.0 0.015"/><mass value="0.04"/><inertia ixx="5e-06" ixy="0" ixz="0" iyy="5e-06" iyz="0" izz="4e-06"/></inertial>
  </link>
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/><child link="link_5"/><origin xyz="0.0 0.0 0.03"/><axis xyz="0.0 0.0 1.0"/>
    <limit lower="-1.5" upper="1.5" effort="0.5" velocity="1.0"/>
  </joint>

  <link name="link_5">
    <visual><geometry><box size="0.02 0.02 0.03"/></geometry><material name="gray"/><origin xyz="0.0 0.0 0.015"/></visual>
    <collision><geometry><box size="0.02 0.02 0.03"/></geometry><origin xyz="0.0 0.0 0.015"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.0 0.0 0.015"/><mass value="0.03"/><inertia ixx="3e-06" ixy="0" ixz="0" iyy="3e-06" iyz="0" izz="2e-06"/></inertial>
  </link>
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/><child link="link_6"/><origin xyz="0.0 0.0 0.03"/><axis xyz="0.0 1.0 0.0"/>
    <limit lower="-1.5" upper="1.5" effort="0.5" velocity="1.0"/>
  </joint>

  <link name="link_6">
    <visual><geometry><box size="0.03 0.02 0.05"/></geometry><material name="orange"/><origin xyz="0.0 0.0 0.025"/></visual>
    <collision><geometry><box size="0.03 0.02 0.05"/></geometry><origin xyz="0.0 0.0 0.025"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.0 0.0 0.025"/><mass value="0.05"/><inertia ixx="1.2e-05" ixy="0" ixz="0" iyy="1.4e-05" iyz="0" izz="5e-06"/></inertial>
  </link>
  <joint name="joint_7" type="revolute">
    <parent link="link_6"/><child link="link_7"/><origin xyz="0.0 0.0 0.05"/><axis xyz="0.0 1.0 0.0"/>
    <limit lower="0.0" upper="0.8" effort="0.5" velocity="0.5"/>
  </joint>

  <link name="link_7">
    <visual><geometry><box size="0.008 0.012 0.04"/></geometry><material name="blue"/><origin xyz="0.0 0.0 0.02"/></visual>
    <collision><geometry><box size="0.008 0.012 0.04"/></geometry><origin xyz="0.0 0.0 0.02"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.0 0.0 0.02"/><mass value="0.01"/><inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="0.0"/></inertial>
  </link>
</robot>
