  </joint>

  <link name="link_4">
    <!-- visual: CAD mesh (a picture, not a measurement); collision: one box per CAD part (robot_core.mesh_import) -->
    <visual><origin xyz="0.0 0.0 0.0"/><geometry><mesh filename="package://robot_description/meshes/karma_robot/link/link_4.stl"/></geometry><material name="blue"/></visual>
    <collision name="j4-j5_ara_parca_1xsg90"><origin xyz="0.01495 5e-05 -5e-05"/><geometry><box size="0.0301 0.0333 0.0281"/></geometry></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.015 0.0 0.0"/><mass value="0.022"/><inertia ixx="3e-06" ixy="0" ixz="0" iyy="3e-06" iyz="0" izz="4e-06"/></inertial>
  </link>
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/><child link="link_5"/><origin xyz="0.025 0.0 0.0"/><axis xyz="0.0 -1.0 0.0"/>
    <limit lower="-1.52" upper="1.52" effort="0.35" velocity="0.8"/>
  </joint>

  <link name="link_5">
    <!-- visual: CAD mesh (a picture, not a measurement); collision: one box per CAD part (robot_core.mesh_import) -->
    <visual><origin xyz="0.0 0.0 0.0"/><geometry><mesh filename="package://robot_description/meshes/karma_robot/link/link_5.stl"/></geometry><material name="gray"/></visual>
    <collision name="j5-j6_kol_2xsg90"><origin xyz="0.01745 5e-05 -5e-05"/><geometry><box size="0.0651 0.0241 0.0261"/></geometry></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
