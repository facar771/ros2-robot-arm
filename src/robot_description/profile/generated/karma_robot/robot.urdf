  </link>
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/><child link="link_6"/><origin xyz="0.05 0.0 0.0"/><axis xyz="1.0 0.0 0.0"/>
    <limit lower="-1.52" upper="1.52" effort="0.18" velocity="0.8"/>
  </joint>

  <link name="link_6">
    <!-- visual: CAD mesh (a picture, not a measurement); collision: one box per CAD part (robot_core.mesh_import) -->
    <visual><origin xyz="0.0 0.0 0.0"/><geometry><mesh filename="package://robot_description/meshes/karma_robot/link/link_6.stl"/></geometry><material name="orange"/></visual>
    <collision name="j6_kiskac_tutucu_1xsg90"><origin xyz="0.00295 5e-05 -5e-05"/><geometry><box size="0.0061 0.0241 0.0261"/></geometry></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
