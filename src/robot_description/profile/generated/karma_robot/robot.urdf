<?xml version="1.0"?>
<!-- ÜRETİLDİ: src/robot_description/profile/karma_robot/karma_robot.yaml dosyasından `python3 -m robot_core.profile_gen --profile src/robot_description/profile/karma_robot/karma_robot.yaml` ile üretildi. ELLE DÜZENLEME: profili düzenle, yeniden üret (pytest güncel mi diye denetler). -->
<robot name="karma_robot">
  <material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.5 1.0 1.0"/></material>

  <!-- base_link needs an <inertial>: without it Gazebo (sdformat) lumps the link into the world and the first joint loses its parent. The xacro wrapper (robot_moveit_config) puts a massless `world` link above it, so KDL never sees an inertia on the root link. -->

  <link name="base_link">
    <visual><geometry><box size="0.1149 0.1203 0.071"/></geometry><material name="gray"/><origin xyz="0.0055 0.0 0.0355"/></visual>
    <collision><geometry><box size="0.1149 0.1203 0.071"/></geometry><origin xyz="0.0055 0.0 0.0355"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.0055 0.0 0.0355"/><mass value="0.15"/><inertia ixx="0.000244" ixy="0" ixz="0" iyy="0.000228" iyz="0" izz="0.000346"/></inertial>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/><origin xyz="0.0 0.0 0.061"/><axis xyz="0.0 0.0 1.0"/>
    <limit lower="-2.967" upper="2.967" effort="0.13" velocity="0.3"/>
  </joint>

  <link name="link_1">
    <visual><geometry><box size="0.122 0.0959 0.0899"/></geometry><material name="orange"/><origin xyz="-0.013 0.0 0.045"/></visual>
    <collision><geometry><box size="0.122 0.0959 0.0899"/></geometry><origin xyz="-0.013 0.0 0.045"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="-0.013 0.0 0.045"/><mass value="0.22"/><inertia ixx="0.000317" ixy="0" ixz="0" iyy="0.000421" iyz="0" izz="0.000441"/></inertial>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/><origin xyz="0.0 0.0 0.06"/><axis xyz="0.0 1.0 0.0"/>
    <limit lower="0.05" upper="3.09" effort="0.5" velocity="0.08"/>
  </joint>

  <link name="link_2">
    <visual><geometry><box size="0.1674 0.048 0.1021"/></geometry><material name="gray"/><origin xyz="-0.0588 0.0 0.0189"/></visual>
    <collision><geometry><box size="0.1674 0.048 0.1021"/></geometry><origin xyz="-0.0588 0.0 0.0189"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="-0.0588 0.0 0.0189"/><mass value="0.26"/><inertia ixx="0.000276" ixy="0" ixz="0" iyy="0.000833" iyz="0" izz="0.000657"/></inertial>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/><origin xyz="-0.12 0.0 0.05"/><axis xyz="0.0 -1.0 0.0"/>
    <limit lower="0.05" upper="3.09" effort="0.35" velocity="0.8"/>
  </joint>

  <link name="link_3">
    <visual><geometry><box size="0.1 0.026 0.0397"/></geometry><material name="orange"/><origin xyz="0.03 0.0 0.0"/></visual>
    <collision><geometry><box size="0.1 0.026 0.0397"/></geometry><origin xyz="0.03 0.0 0.0"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.03 0.0 0.0"/><mass value="0.11"/><inertia ixx="2.1e-05" ixy="0" ixz="0" iyy="0.000106" iyz="0" izz="9.8e-05"/></inertial>
  </link>
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/><child link="link_4"/><origin xyz="0.08 0.0 0.0"/><axis xyz="1.0 0.0 0.0"/>
    <limit lower="-1.52" upper="1.52" effort="0.18" velocity="0.8"/>
  </joint>

  <link name="link_4">
    <visual><geometry><box size="0.03 0.0332 0.028"/></geometry><material name="blue"/><origin xyz="0.015 0.0 0.0"/></visual>
    <collision><geometry><box size="0.03 0.0332 0.028"/></geometry><origin xyz="0.015 0.0 0.0"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.015 0.0 0.0"/><mass value="0.022"/><inertia ixx="3e-06" ixy="0" ixz="0" iyy="3e-06" iyz="0" izz="4e-06"/></inertial>
  </link>
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/><child link="link_5"/><origin xyz="0.025 0.0 0.0"/><axis xyz="0.0 -1.0 0.0"/>
    <limit lower="-1.52" upper="1.52" effort="0.35" velocity="0.8"/>
  </joint>

  <link name="link_5">
    <visual><geometry><box size="0.065 0.024 0.026"/></geometry><material name="gray"/><origin xyz="0.0175 0.0 0.0"/></visual>
    <collision><geometry><box size="0.065 0.024 0.026"/></geometry><origin xyz="0.0175 0.0 0.0"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.0175 0.0 0.0"/><mass value="0.063"/><inertia ixx="7e-06" ixy="0" ixz="0" iyy="2.6e-05" iyz="0" izz="2.5e-05"/></inertial>
  </link>
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/><child link="link_6"/><origin xyz="0.05 0.0 0.0"/><axis xyz="1.0 0.0 0.0"/>
    <limit lower="-1.52" upper="1.52" effort="0.18" velocity="0.8"/>
  </joint>

  <link name="link_6">
    <visual><geometry><box size="0.006 0.024 0.026"/></geometry><material name="orange"/><origin xyz="0.003 0.0 0.0"/></visual>
    <collision><geometry><box size="0.006 0.024 0.026"/></geometry><origin xyz="0.003 0.0 0.0"/></collision>
    <!-- placeholder mass; inertia = solid primitive of this shape and mass (replace with real CAD values) -->
    <inertial><origin xyz="0.003 0.0 0.0"/><mass value="0.013"/><inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/></inertial>
  </link>
</robot>
