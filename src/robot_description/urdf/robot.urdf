<?xml version="1.0"?>
<robot name="six_axis_robot">
  <material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.5 1.0 1.0"/></material>

  <!-- base_link: no <inertial> on purpose (KDL does not support an inertia on the root link) -->
  <link name="base_link">
    <visual><geometry><cylinder radius="0.12" length="0.08"/></geometry><material name="gray"/></visual>
    <collision><geometry><cylinder radius="0.12" length="0.08"/></geometry></collision>
  </link>

  <link name="link_1">
    <visual><geometry><cylinder radius="0.08" length="0.2"/></geometry><material name="orange"/><origin xyz="0 0 0.1"/></visual>
    <collision><geometry><cylinder radius="0.08" length="0.2"/></geometry><origin xyz="0 0 0.1"/></collision>
    <!-- placeholder mass/inertia (solid primitive approximation); replace with real CAD values -->
    <inertial><origin xyz="0 0 0.1"/><mass value="2.0"/><inertia ixx="0.009867" ixy="0" ixz="0" iyy="0.009867" iyz="0" izz="0.006400"/></inertial>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/><origin xyz="0 0 0.04"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>

  <link name="link_2">
    <visual><geometry><box size="0.06 0.06 0.35"/></geometry><material name="gray"/><origin xyz="0 0 0.175"/></visual>
    <collision><geometry><box size="0.06 0.06 0.35"/></geometry><origin xyz="0 0 0.175"/></collision>
    <!-- placeholder mass/inertia (solid primitive approximation); replace with real CAD values -->
    <inertial><origin xyz="0 0 0.175"/><mass value="1.5"/><inertia ixx="0.015762" ixy="0" ixz="0" iyy="0.015762" iyz="0" izz="0.000900"/></inertial>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/><origin xyz="0 0 0.2"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
  </joint>

  <link name="link_3">
    <visual><geometry><box size="0.05 0.05 0.3"/></geometry><material name="orange"/><origin xyz="0 0 0.15"/></visual>
    <collision><geometry><box size="0.05 0.05 0.3"/></geometry><origin xyz="0 0 0.15"/></collision>
    <!-- placeholder mass/inertia (solid primitive approximation); replace with real CAD values -->
    <inertial><origin xyz="0 0 0.15"/><mass value="1.0"/><inertia ixx="0.007708" ixy="0" ixz="0" iyy="0.007708" iyz="0" izz="0.000417"/></inertial>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/><origin xyz="0 0 0.35"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="100" velocity="1.0"/>
  </joint>

  <link name="link_4">
    <visual><geometry><cylinder radius="0.04" length="0.2"/></geometry><material name="blue"/><origin xyz="0 0 0.1"/></visual>
    <collision><geometry><cylinder radius="0.04" length="0.2"/></geometry><origin xyz="0 0 0.1"/></collision>
    <!-- placeholder mass/inertia (solid primitive approximation); replace with real CAD values -->
    <inertial><origin xyz="0 0 0.1"/><mass value="0.6"/><inertia ixx="0.002240" ixy="0" ixz="0" iyy="0.002240" iyz="0" izz="0.000480"/></inertial>
  </link>
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/><child link="link_4"/><origin xyz="0 0 0.3"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>

  <link name="link_5">
    <visual><geometry><box size="0.04 0.04 0.15"/></geometry><material name="gray"/><origin xyz="0 0 0.075"/></visual>
    <collision><geometry><box size="0.04 0.04 0.15"/></geometry><origin xyz="0 0 0.075"/></collision>
    <!-- placeholder mass/inertia (solid primitive approximation); replace with real CAD values -->
    <inertial><origin xyz="0 0 0.075"/><mass value="0.4"/><inertia ixx="0.000803" ixy="0" ixz="0" iyy="0.000803" iyz="0" izz="0.000107"/></inertial>
  </link>
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/><child link="link_5"/><origin xyz="0 0 0.2"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
  </joint>

  <link name="link_6">
    <visual><geometry><cylinder radius="0.03" length="0.05"/></geometry><material name="orange"/><origin xyz="0 0 0.025"/></visual>
    <collision><geometry><cylinder radius="0.03" length="0.05"/></geometry><origin xyz="0 0 0.025"/></collision>
    <!-- placeholder mass/inertia (solid primitive approximation); replace with real CAD values -->
    <inertial><origin xyz="0 0 0.025"/><mass value="0.2"/><inertia ixx="0.000087" ixy="0" ixz="0" iyy="0.000087" iyz="0" izz="0.000090"/></inertial>
  </link>
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/><child link="link_6"/><origin xyz="0 0 0.15"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>
</robot>
