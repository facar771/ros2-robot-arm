<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_vision_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 adapters for robot_vision: camera-platform tracking node, tracking world launch, selftest</description>
  <maintainer email="facar7711@gmail.com">facar771</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>robot_core</depend>
  <depend>robot_vision</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ros_gz_interfaces</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>robot_sim</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
