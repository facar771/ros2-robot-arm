<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_hw_bridge</name>
  <version>0.1.0</version>
  <description>ESP32 donanım hattı: ROS'suz mesaj kodeği (CRC16+seq), ESP32 simülatörü, host tarafı bağlantı (B1)</description>
  <maintainer email="facar7711@gmail.com">facar771</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>robot_core</depend>
  <depend>control_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_moveit_config</exec_depend>   <!-- hw_stack.launch.py: rsp + move_group -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
